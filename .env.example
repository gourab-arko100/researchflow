# --- Database (Postgres with the pgvector extension enabled — e.g. Supabase or Neon) ---
# DATABASE_URL: pooled connection (Supabase "transaction pooler", port 6543) — used by the running app
# DIRECT_URL: direct/session connection (port 5432, or Supabase "session pooler") — used by prisma db push / migrate
DATABASE_URL=
DIRECT_URL=

# --- Auth (Clerk — https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
# From Clerk dashboard → Webhooks → your endpoint's signing secret
CLERK_WEBHOOK_SECRET=

# --- File storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=

# --- AI (Google Gemini — free tier via https://aistudio.google.com/apikey) ---
# Used for gemini-3.6-flash (chat/summarization/comparison/research-gaps/lit-review)
# and gemini-embedding-001 (chunk + query embeddings, truncated to 768 dims).
# Leave unset and the app runs entirely on the Demo providers (DemoAIService /
# DemoEmbeddingService) — real retrieval, extractive answers, zero API cost.
# The public /demo workspace always uses the Demo providers regardless of this key.
GEMINI_API_KEY=
